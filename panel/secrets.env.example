# ===========================================================================
# Modelo de configuração do painel.
# Copie este arquivo para "secrets.env" e preencha com os seus valores:
#
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env        # Linux/macOS — restringe a leitura
#
# O arquivo secrets.env NÃO é versionado (está no .gitignore). Nunca o commite.
# O parser do config.php lê pares CHAVE=VALOR; o valor vai até o fim da linha,
# então NÃO use aspas e NÃO coloque comentários na mesma linha de um valor.
# ===========================================================================

# --- Banco de dados (MySQL/MariaDB) ---------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rustdesk_panel
DB_USER=rustdesk_panel
DB_PASS=troque-esta-senha

# Chave secreta da aplicação (sessões/tokens). Gere uma aleatória, ex.:
#   openssl rand -hex 32
APP_KEY=troque-por-uma-chave-aleatoria-longa

# --- Identidade / marca do painel -----------------------------------------
PANEL_BRAND=Meu Suporte
PANEL_TITLE=Meu Suporte · Suporte Remoto

# URL pública da API do painel — é embutida nos instaladores do cliente.
# Use o domínio (com https) que aponta para este painel.
API_SERVER_URL=https://rd.exemplo.com

# IP ou host público do servidor de ID/rendezvous (hbbs). Apenas exibido no
# painel (aba Configurações) como referência. Deixe em branco se não quiser exibir.
ID_SERVER=

# Fuso horário usado na exibição do painel (ex.: America/Sao_Paulo, UTC).
DISPLAY_TZ=America/Sao_Paulo
